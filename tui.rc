# tui.rc — taskwarrior-tui configuration
# Used as TASKRC for taskwarrior-tui so it never writes to ~/.taskrc
# Launch with: taskwarrior-tui --taskrc ~/.task/config/tui.rc

# Include main taskrc for all standard config
include ~/.taskrc

# tui context (written here by 'task context <name>' inside tui)
context=cmx:need,tod

# taskwarrior-tui UDA config
uda.taskwarrior-tui.task-report.show-info=true
uda.taskwarrior-tui.task-report.looping=false
uda.taskwarrior-tui.task-report.date-time-vague-more-precise=false
nag=task 74 \"assemble realed expenses\" is scheduled for TODAY!
