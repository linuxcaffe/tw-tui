# tui.rc — taskwarrior-tui configuration
# Used as TASKRC so taskwarrior-tui never writes to ~/.taskrc.
# The tw-tui wrapper launches with: TASKRC=~/.task/config/tui.rc

# Include your main taskrc — contexts, reports, hooks config all come in from here
include ~/.taskrc

# tui writes context changes here (not to ~/.taskrc)
# The tw-tui wrapper syncs this from ~/.taskrc before each launch.
context=

# taskwarrior-tui UDA settings — adjust to taste
uda.taskwarrior-tui.task-report.show-info=true
uda.taskwarrior-tui.task-report.looping=false
uda.taskwarrior-tui.task-report.date-time-vague-more-precise=false
